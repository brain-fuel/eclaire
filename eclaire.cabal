cabal-version: 3.0
name: eclaire
version: 0.1.2.0
synopsis: Cross-language semantic UI layout engine powered by Clay
description: A cross-language semantic UI and layout engine with a C ABI,
             Haskell bindings, and a versioned semantic contract.
category: UI
license: MIT AND Zlib
license-file: LICENSE
author: Eclaire contributors
maintainer: Eclaire contributors
build-type: Simple
extra-source-files:
  eclaire.toml
  ir-v1.json
  README.md
  third_party/clay/README.md
  third_party/clay/LICENSE.md
  third_party/clay/clay.h
extra-doc-files: CHANGELOG.md

source-repository head
  type: git
  location: https://github.com/brain-fuel/eclaire.git

library
  exposed-modules: Eclaire
  hs-source-dirs: bindings/haskell
  c-sources: src/eclaire.c
  include-dirs: include, third_party/clay
  install-includes: eclaire.h
  build-depends: base >= 4.14 && < 5
  default-language: Haskell2010
  ghc-options: -Wall
  if os(linux)
    extra-libraries: m

executable eclaire
  main-is: Main.hs
  hs-source-dirs: bindings/haskell-cli
  build-depends: base >= 4.14 && < 5, eclaire
  default-language: Haskell2010
  ghc-options: -Wall
