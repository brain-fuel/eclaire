cabal-version: 3.0
name: elmish-clay-web
version: 0.1.0.0
build-type: Simple
license: MIT

executable elmish-clay-web
  main-is: Main.hs
  hs-source-dirs: app
  build-depends: base < 5, miso >= 1.14
  default-language: Haskell2010
  default-extensions: OverloadedStrings, LambdaCase
  ghc-options: -Wall
  if arch(wasm32)
    ghc-options: -no-hs-main -optl-mexec-model=reactor "-optl-Wl,--export=hs_start"
    cpp-options: -DWASM
